#include <stdio.h>

int main()
{
    char str[100];
    int i, j, flag = 1;

    printf("Enter a string: ");
    gets(str);

    j = 0;

    while (str[j] != '\0')
        j++;

    j--;

    for (i = 0; i < j; i++, j--)
    {
        if (str[i] != str[j])
        {
            flag = 0;
            break;
        }
    }

    if (flag == 1)
        printf("Palindrome");
    else
        printf("Not Palindrome");

    return 0;
}
