#include <stdio.h>

int main()
{
    char str[200], word[100];
    int i, j = 0, max = 0, len;

    printf("Enter a sentence: ");
    gets(str);

    for (i = 0; ; i++)
    {
        if (str[i] != ' ' && str[i] != '\0')
        {
            word[j] = str[i];
            j++;
        }
        else
        {
            word[j] = '\0';
            len = j;

            if (len > max)
            {
                max = len;
            }

            j = 0;

            if (str[i] == '\0')
                break;
        }
    }

    printf("Length of longest word = %d", max);

    return 0;
}
