#include <stdio.h>

int main()
{
    char str1[100], str2[100];
    int i, j, count = 0;

    printf("Enter first string: ");
    gets(str1);

    printf("Enter second string: ");
    gets(str2);

    for (i = 0; str1[i] != '\0'; i++)
    {
        count = 0;

        for (j = 0; str2[j] != '\0'; j++)
        {
            if (str1[i] == str2[j])
            {
                count++;
                str2[j] = '*';
                break;
            }
        }

        if (count == 0)
            break;
    }

    if (str1[i] == '\0')
        printf("Anagram");
    else
        printf("Not Anagram");

    return 0;
}
