#include <stdio.h>

int main()
{
    int i, j, k, n;

    for(i = 1; i <= 7; i++)
    {
        if(i <= 4)
            n = 2 * i - 1;
        else
            n = 2 * (7 - i) + 1;

        for(k = 1; k <= 4 - (n + 1) / 2; k++)
            printf(" ");

        for(j = 1; j <= n; j++)
            printf("*");

        printf("\n");
    }

    return 0;
}
