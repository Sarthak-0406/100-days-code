#include <stdio.h>

int main()
{
    char str[100];
    int i;

    printf("Enter your name: ");
    gets(str);

    printf("%c", str[0]);

    for (i = 1; str[i] != '\0'; i++)
    {
        if (str[i] == ' ' && str[i + 1] != '\0')
            printf(".%c", str[i + 1]);
    }

    printf(".");

    return 0;
}
